{
  "appId": "io.creezio.tempoflow3",
  "productName": "TempoFlow",
  "copyright": "© TempoFlow",
  "directories": {
    "output": "dist-electron",
    "buildResources": "resources"
  },
  "files": [
    "build/electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/electron",
      "to": "build/electron",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/renderer",
      "to": "renderer"
    }
  ],
  "asar": true,
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "installer.nsh"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "electronVersion": "35.7.5",
  "linux": {
    "target": [
      "AppImage",
      "dir"
    ],
    "category": "Office",
    "icon": "resources/icons/client.png"
  }
}

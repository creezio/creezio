{
  "name": "@creezio/mails",
  "version": "0.1.0",
  "description": "Mails natifs plateforme Creezio (boîte générique + PJ + UI + slot providers marque)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "import": "./ui/index.ts",
      "default": "./ui/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "ui",
    "email-worker"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:inbox": "node --import tsx/esm ../../scripts/test-mails-inbox.mjs"
  },
  "dependencies": {
    "@creezio/api-kernel": "0.1.0",
    "@creezio/auth": "0.1.0",
    "@creezio/platform-core": "0.1.0",
    "@creezio/shell-ui": "0.1.0",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js"
}

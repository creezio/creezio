{
  "name": "@creezio/electron-shell",
  "version": "0.1.0",
  "description": "Runtime Electron plateforme Creezio (updater, tray, splash, boot, launchers génériques)",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./browser-tabs": {
      "types": "./dist/host/browser-tabs/index.d.ts",
      "import": "./dist/host/browser-tabs/index.js",
      "require": "./dist-cjs/host/browser-tabs/index.js",
      "default": "./dist/host/browser-tabs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@creezio/brand-config": "0.1.0",
    "@creezio/observability": "0.1.0",
    "@creezio/platform-core": "0.1.0",
    "@creezio/product-hub": "0.1.0",
    "@creezio/shell": "0.1.0"
  },
  "peerDependencies": {
    "electron": ">=28",
    "electron-updater": ">=6"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "license": "UNLICENSED",
  "module": "./dist/index.js"
}
